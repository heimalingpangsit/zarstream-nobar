{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zarstream-nobar",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",

  "durable_objects": {
    "bindings": [
      {
        "name": "NOBAR_ROOM",
        "class_name": "NobarRoomDO"
      }
    ]
  },

  "exports": {
    "NobarRoomDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
